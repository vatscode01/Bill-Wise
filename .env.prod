# .env.prod — Production environment variables template
# COPY this to .env.prod.local and fill in real values.
# NEVER commit .env.prod.local to git!

# ── Database ──────────────────────────────────────────────────────
POSTGRES_USER=billwise_prod
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=billwise_prod

# ── Backend ───────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_VERY_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── OpenAI ────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Email (SMTP) ──────────────────────────────────────────────────
MAIL_USERNAME=your-gmail@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_FROM=noreply@yourdomain.com
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
REMINDER_DAYS_BEFORE=3

# ── Frontend ──────────────────────────────────────────────────────
# This must match the domain you configure in nginx
NEXT_PUBLIC_API_URL=https://yourdomain.com/api
