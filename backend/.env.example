DATABASE_URL=postgresql://billwise:billwise@localhost:5432/billwise
JWT_SECRET=change-this-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
OPENAI_API_KEY=your-openai-api-key

# CORS: comma-separated list of allowed frontend origins
# Default is localhost:3000 for local dev.
# In production, set this to your real domain, e.g. https://yourdomain.com
CORS_ORIGINS=http://localhost:3000

# Email reminders — use an App Password for Gmail
MAIL_USERNAME=your-gmail@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_FROM=your-gmail@gmail.com
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
# Days before due date to send reminder. Set to 0 to disable.
REMINDER_DAYS_BEFORE=3
